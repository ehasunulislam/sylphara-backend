model User {
    id              String      @id @default(uuid())
    name            String      @db.VarChar(50)
    email           String      @unique
    password        String
    role            UserRole
    status          UserStatus @default(ACTIVE)
    profilePhoto    String?

    profile         Profile?

    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt   

    @@map("user")    
}